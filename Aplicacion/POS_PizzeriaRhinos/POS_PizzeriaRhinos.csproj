<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cbccb41e-e005-46a7-9b3d-cf62269965ec</UserSecretsId>
    <ApplicationIcon>Recursos\rhinos.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyTitle>Rhinos Pizza - Punto de Venta</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

  <!-- Logo e ícono: se copian junto al .exe para que la interfaz los cargue en tiempo de ejecución -->
  <ItemGroup>
    <None Update="Recursos\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
